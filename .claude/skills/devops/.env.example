# Auto Company - Environment Variables Example
# Copy this to .env and fill in your actual values
# Never commit the actual .env file to version control

# GitHub
GITHUB_TOKENgho_REDACTEDyour_github_token_here

# Cloudflare
# Get these from: https://dash.cloudflare.com
# API Token: Profile -> API Tokens -> Create Token
# Account ID: Overview -> Account ID (right sidebar)
CLOUDFLARE_API_TOKENgho_REDACTEDyour_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_IDgho_REDACTEDyour_cloudflare_account_id_here
CLOUDFLARE_ZONE_IDgho_REDACTEDyour_zone_id_here

# Google Cloud
# Authentication via service account key file or gcloud CLI
# Download from: IAM & Admin -> Service Accounts -> Create Key
GOOGLE_APPLICATION_CREDENTIALSgho_REDACTED/path/to/service-account-key.json
GCP_PROJECT_IDgho_REDACTEDyour-project-id
GCP_REGIONgho_REDACTEDus-central1
GCP_ZONEgho_REDACTEDus-central1-a

# Docker Registry (optional)
DOCKER_USERNAMEgho_REDACTEDyour_docker_username
DOCKER_PASSWORDgho_REDACTEDyour_docker_password

# CI/CD (optional)
GITHUB_TOKEN_CIgho_REDACTEDyour_github_token
GITLAB_TOKENgho_REDACTEDyour_gitlab_token

# Monitoring (optional)
SENTRY_DSNgho_REDACTEDyour_sentry_dsn
DD_API_KEYgho_REDACTEDyour_datadog_api_key

# Notes
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. Use different credentials for dev/staging/production
# 4. Rotate credentials regularly
# 5. Use least-privilege principle for API tokens
