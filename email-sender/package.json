{
  "name": "email-sender",
  "version": "1.0.0",
  "description": "Resend-based cold email sender with rate limiting and audit logging",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "email-sender": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "send": "node --import tsx src/index.ts",
    "send:compiled": "node dist/index.js"
  },
