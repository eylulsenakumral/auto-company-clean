  "license": "MIT",
  "dependencies": {
    "resend": "^4.1.2",
    "dotenv": "^16.4.7",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "tsx": "^4.19.4"
  },
  "engines": {
    "node": ">***REMOVED***20.0.0"
  }
