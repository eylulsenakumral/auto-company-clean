# Production Environment Variables - Railway
# Copy this to Railway Variables (Settings → Variables)
# DO NOT commit actual values to git

# Required: Bot token from @BotFather
TELEGRAM_BOT_TOKEN***REMOVED***your_bot_token_here

# Required: Random webhook secret string
WEBHOOK_SECRET***REMOVED***your_random_secret_string_min_32_chars

# Database: Persistent volume path
DATABASE_URL***REMOVED***sqlite:./data/orders.db

# Environment
NODE_ENV***REMOVED***production

# Logging: error | warn | info | debug
LOG_LEVEL***REMOVED***info

# Server Port (Railway sets this automatically)
PORT***REMOVED***3000

# Railway Auto-populated (do not set manually)
# RAILWAY_ENVIRONMENT***REMOVED***
# RAILWAY_SERVICE_NAME***REMOVED***
# RAILWAY_PROJECT_NAME***REMOVED***
# RAILWAY_PROJECT_ID***REMOVED***
# RAILWAY_VOLUME_ID***REMOVED***
