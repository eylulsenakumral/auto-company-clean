# NextVision Occupational Safety - Environment Configuration
# Copy this to .env and fill in production values

# Database
POSTGRES_PASSWORD***REMOVED***change_this_strong_password_123

# Redis
REDIS_PASSWORD***REMOVED***change_this_redis_password_456

# MinIO Object Storage
MINIO_ACCESS_KEY***REMOVED***nextvision_admin
MINIO_SECRET_KEY***REMOVED***change_this_minio_secret_789

# Application Security
JWT_SECRET***REMOVED***change_this_jwt_secret_please_use_strong_random_string

# RTSP Camera Configuration (First Camera)
RTSP_CAMERA_1_URL***REMOVED***rtsp://camera_ip:554/stream1
RTSP_CAMERA_1_NAME***REMOVED***Factory Floor Main
RTSP_CAMERA_1_LOCATION***REMOVED***production_line_a

# YOLO Model Configuration
YOLO_MODEL_VERSION***REMOVED***yolov8n
YOLO_CONFIDENCE_THRESHOLD***REMOVED***0.5
